<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème fenêtre minimal (framework, pas d'AppCompat) : fond clair dès le lancement, aucun flash. -->
    <style name="Theme.PhonePilote" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pp_bg</item>
        <item name="android:colorBackground">@color/pp_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
